<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.cliplet" path="/org/gnome/shell/extensions/cliplet/">
    <key name="history-length" type="i">
      <range min="5" max="25"/>
      <default>15</default>
      <summary>History length</summary>
      <description>Maximum number of saved texts.</description>
    </key>
    <key name="paused" type="b">
      <default>false</default>
      <summary>Pause collection</summary>
      <description>Do not save new texts while collection is paused.</description>
    </key>
  </schema>
</schemalist>
